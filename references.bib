@mastersthesis{plaza_torres_new_2023,
	address = {United States -- Colorado},
	title = {New {Applications} of {Carbon} {Stable} {Isotope} {Geochemistry} to {Coprolites} and {Plant} {Fossils}},
	isbn = {979-8-3803-6458-4},
	url = {https://colorado.idm.oclc.org/login?url=https://www.proquest.com/dissertations-theses/new-applications-carbon-stable-isotope/docview/2866259546/se-2?accountid=14503},
	abstract = {Coprolites and plant fossils can provide valuable information about the diets of ancient organisms and Earth’s past terrestrial surface environment. In this thesis two research projects were undertaken: carbonate 𝛿13𝐶 analysis was used to estimate the microbial respiration rates recorded in herbivorous dinosaur coprolites, and a method for sampling and preparation was developed to analyze the organic matter 𝛿13𝐶 of fossil plants with minimal disturbance. Coprolites from the Two Medicine Fm. and Kaiparowits Fm. were used for the respiration rate project and plant fossils from the Creede Fm. and the Green River Fm. were used for the methodology project. Coprolite microbial respiration rates resulted to be higher than soil respiration rates modeled for paleosols from the same formations, suggesting that microbial activity influenced the mineralization of these coprolites. For the plant fossil sampling methodology, 𝛿13𝐶 data was obtained by only destroying sub-centimeter areas of a specimen, which opens the doors to sampling museum specimens for geochemical analysis with minimal damage that would not impact future research.},
	language = {English},
	school = {University of Colorado at Boulder},
	author = {Plaza Torres, Stephanie Marie},
	collaborator = {Wing, Boswell},
	year = {2023},
	note = {Publication Title: ProQuest Dissertations and Theses
30635123},
	keywords = {Coprolites, Geochemistry, Geology, 0418:Paleontology, 0481:Soil sciences, 0996:Geochemistry, Carbon stable isotopes, Dinosaur, Microbial respiration rates, Paleontology, Plant fossils, Respiration rates, Soil sciences},
	annote = {Copyright - Database copyright ProQuest LLC; ProQuest does not claim copyright in the individual underlying works.},
